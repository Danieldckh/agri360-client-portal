# Base URL of the Agri360 CRM API the portal proxies to.
CRM_API_BASE=https://agri360.proagrihub.com

# Shared portal key. Sent to the CRM as the `X-Portal-Key` header SERVER-SIDE.
# The browser never sees this value. Set the real key in Coolify env, not here.
PORTAL_KEY=PASTE_PORTAL_KEY_HERE

# Port the Express server listens on (Coolify maps this).
PORT=3000
